<!--
  Design tokens. Generated by hand from replica/design/tokens.json; keep the two in sync.
  Components use these keys only: no raw colours or sizes in views.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- colour roles -->
    <Color x:Key="Color.Bg">#000000</Color>
    <Color x:Key="Color.Surface">#0F0F0F</Color>
    <Color x:Key="Color.SurfaceHover">#1B1B1B</Color>
    <Color x:Key="Color.SurfaceActive">#222222</Color>
    <Color x:Key="Color.Track">#363636</Color>
    <Color x:Key="Color.Text">#F2F2F2</Color>
    <Color x:Key="Color.TextMuted">#9A9A9A</Color>
    <Color x:Key="Color.TextFaint">#7E7E7E</Color>
    <Color x:Key="Color.Accent">#6FD3B8</Color>
    <Color x:Key="Color.OnAccent">#06120F</Color>
    <Color x:Key="Color.Accent2">#B9D98A</Color>
    <Color x:Key="Color.OnAccent2">#10180A</Color>
    <Color x:Key="Color.Control">#F2F2F2</Color>
    <Color x:Key="Color.OnControl">#000000</Color>
    <Color x:Key="Color.Danger">#FF6161</Color>
    <Color x:Key="Color.Success">#4CC38A</Color>
    <Color x:Key="Color.Warning">#F2C94C</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="{StaticResource Color.SurfaceActive}"/>
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/>
    <SolidColorBrush x:Key="Brush.Accent2" Color="{StaticResource Color.Accent2}"/>
    <SolidColorBrush x:Key="Brush.OnAccent2" Color="{StaticResource Color.OnAccent2}"/>
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
    <SolidColorBrush x:Key="Brush.OnControl" Color="{StaticResource Color.OnControl}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>

    <!-- type -->
    <FontFamily x:Key="Font.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Type.Overline">11</sys:Double>
    <sys:Double x:Key="Type.Xs">12</sys:Double>
    <sys:Double x:Key="Type.Sm">13</sys:Double>
    <sys:Double x:Key="Type.Base">14</sys:Double>
    <sys:Double x:Key="Type.Pill">15</sys:Double>
    <sys:Double x:Key="Type.Title">17</sys:Double>

    <!-- radius -->
    <CornerRadius x:Key="Radius.Sm">8</CornerRadius>
    <CornerRadius x:Key="Radius.Md">12</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <sys:Double x:Key="Radius.Panel">28</sys:Double>

    <!-- space -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">6</sys:Double>
    <sys:Double x:Key="Space.3">8</sys:Double>
    <sys:Double x:Key="Space.4">12</sys:Double>
    <sys:Double x:Key="Space.5">16</sys:Double>
    <sys:Double x:Key="Space.6">20</sys:Double>
    <sys:Double x:Key="Space.7">24</sys:Double>
    <Thickness x:Key="Pad.Panel">16</Thickness>
    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Gap">0,0,8,8</Thickness>

    <!-- layout -->
    <sys:Double x:Key="Layout.PillWidth">210</sys:Double>
    <sys:Double x:Key="Layout.PillHeight">38</sys:Double>
    <sys:Double x:Key="Layout.AlertHeight">64</sys:Double>
    <sys:Double x:Key="Layout.WidePillWidth">380</sys:Double>
    <sys:Double x:Key="Layout.MusicPillWidth">300</sys:Double>
    <sys:Double x:Key="Layout.MiniArt">64</sys:Double>
    <sys:Double x:Key="Layout.LyricsWidth">280</sys:Double>
    <sys:Double x:Key="Motion.PillWave">2.5</sys:Double>
    <sys:Double x:Key="Motion.PanelWave">6</sys:Double>
    <sys:Double x:Key="Layout.PanelWidth">720</sys:Double>
    <sys:Double x:Key="Layout.PanelHeight">360</sys:Double>
    <sys:Double x:Key="Layout.TabBarHeight">32</sys:Double>
    <sys:Double x:Key="Layout.Art">96</sys:Double>
    <sys:Double x:Key="Layout.Play">40</sys:Double>
    <sys:Double x:Key="Layout.Skip">28</sys:Double>
    <sys:Double x:Key="Layout.TileWidth">112</sys:Double>
    <sys:Double x:Key="Layout.TileHeight">46</sys:Double>
    <sys:Double x:Key="Layout.DockIcon">40</sys:Double>

    <!-- motion -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Base">0:0:0.22</Duration>
    <sys:Double x:Key="Motion.SpringStiffness">380</sys:Double>
    <sys:Double x:Key="Motion.SpringDamping">32</sys:Double>

</ResourceDictionary>
