<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stillbar.Core\Stillbar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport (user32 P/Invoke) generates unsafe marshalling code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Stillbar</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\stillbar.ico</ApplicationIcon>
    <Product>Stillbar</Product>
    <Description>Полоска сверху, которая не мешает работать</Description>
    <!-- Program.Main: the hook mode answers Claude Code without starting WPF -->
    <StartupObject>Stillbar.App.Program</StartupObject>
  </PropertyGroup>

</Project>
