<UserControl x:Class="Stillbar.App.Shell.BarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{x:Null}">

    <!-- Rule: no clr-namespace types from this assembly or Stillbar.Core in this file (see build-log: markup pass 2 drops the BAML). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Progress bar shared by the Home card and the mini player. Scrub handlers are attached in code by name. -->
        <Style x:Key="TrackProgress" TargetType="Slider" BasedOn="{StaticResource Slider.Thin}">
            <Setter Property="Foreground" Value="{Binding ProgressBrush}"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="{Binding DurationSeconds}"/>
            <Setter Property="Value" Value="{Binding PositionSeconds, Mode=TwoWay}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsEnabled" Value="{Binding CanSeek}"/>
            <Setter Property="AutomationProperties.Name" Value="Позиция трека"/>
        </Style>

        <Style x:Key="ComingSoonTile" TargetType="Button" BasedOn="{StaticResource ActionTile}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="ToolTip" Value="Появится позже"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
    </UserControl.Resources>

    <!-- Background stays null outside the shape: fully transparent pixels let clicks fall through to the desktop. -->
    <Grid Background="{x:Null}">
        <Grid x:Name="Bar" HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="{StaticResource Layout.PillWidth}" Height="{StaticResource Layout.PillHeight}">

            <!-- The black body: rounded bottom, liquid wave along the open panel's bottom edge. Geometry built in code. -->
            <Path x:Name="Outline" Fill="{StaticResource Brush.Bg}"/>

            <Border x:Name="Body" ClipToBounds="True">
                <Grid>
                    <!-- ===================== collapsed: the pill ===================== -->
                    <Grid x:Name="PillContent" VerticalAlignment="Top">
                    <Grid Height="{StaticResource Layout.PillHeight}" VerticalAlignment="Top" Margin="16,0"
                          Visibility="{Binding ShowNormalPill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding Clock}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowPillClock, Converter={StaticResource BoolToVis}}"/>

                        <!-- timer: glyph · countdown · clock -->
                        <Grid Visibility="{Binding ShowPillTimer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="16" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding TimerText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding Clock}" Foreground="{StaticResource Brush.TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- left: weather (idle) or cover (music) -->
                        <Path Style="{StaticResource WeatherGlyph}" HorizontalAlignment="Left"
                              Data="{Binding WeatherIcon}" Stroke="{Binding WeatherBrush}"
                              Visibility="{Binding ShowPillWeatherIcon, Converter={StaticResource BoolToVis}}"/>
                        <Border Width="26" Height="26" CornerRadius="6" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                Background="{StaticResource Brush.SurfaceActive}"
                                Visibility="{Binding ShowPillMusic, Converter={StaticResource BoolToVis}}">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- right: temperature, then equaliser bars while music plays -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding TemperatureText}"
                                       Visibility="{Binding ShowPillTemperature, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Height="16"
                                        Visibility="{Binding ShowPillMusic, Converter={StaticResource BoolToVis}}">
                                <Rectangle x:Name="EqBar1" Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{Binding ProgressBrush}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <Rectangle x:Name="EqBar2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{Binding ProgressBrush}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <Rectangle x:Name="EqBar3" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="{Binding ProgressBrush}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <Rectangle x:Name="EqBar4" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{Binding ProgressBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- download: glyph · name ... size · speed -->
                        <DockPanel VerticalAlignment="Center" Visibility="{Binding ShowPillDownload, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding DownloadGlyph}" Foreground="{Binding DownloadBrush}" FontSize="15" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                            <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource Type.Sm}" Text="{Binding DownloadDetail}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding DownloadName}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- status toast -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" FontSize="14" Foreground="{Binding StatusBrush}" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource Text.Pill}" FontWeight="Normal" Text="{Binding StatusText}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Claude Code at work: project · what it is doing · for how long -->
                    <DockPanel Height="{StaticResource Layout.PillHeight}" VerticalAlignment="Top" Margin="16,0"
                               Visibility="{Binding IsAgentPill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="{StaticResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource Text.Pill}" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding AgentElapsed}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Text.Pill}" FontWeight="Normal" Text="{Binding AgentText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- dictation: what is being heard, and a stop button (hovering it does not open the panel) -->
                    <DockPanel Height="{StaticResource Layout.PillHeight}" VerticalAlignment="Top" Margin="16,0,6,0"
                               Visibility="{Binding IsListeningPill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="15" Foreground="{StaticResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE71A;" FontSize="12" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center"
                                ToolTip="Остановить диктовку" AutomationProperties.Name="Остановить диктовку" Command="{Binding StopDictationCommand}"/>
                        <TextBlock Style="{StaticResource Text.Pill}" FontWeight="Normal" Text="{Binding DictationText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- screen recording: a red dot and the time; the Home tile stops it -->
                    <Grid Height="{StaticResource Layout.PillHeight}" VerticalAlignment="Top" Margin="16,0"
                          Visibility="{Binding IsRecordingPill, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Danger}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Text.Pill}" Text="Запись" Margin="0,0,10,0"/>
                            <TextBlock Style="{StaticResource Text.Pill}" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding RecordingText}"/>
                        </StackPanel>
                    </Grid>

                    <!-- timer finished: taller pill with its own buttons (hovering it does not open the panel) -->
                    <DockPanel Height="{StaticResource Layout.AlertHeight}" VerticalAlignment="Top" Margin="18,0,14,0"
                               Visibility="{Binding IsAlertPill, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding AlertGlyph}" FontSize="20" Foreground="{StaticResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource IconButton.Control}" Content="&#xE73E;" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center"
                                ToolTip="{Binding AlertPrimaryLabel}" AutomationProperties.Name="{Binding AlertPrimaryLabel}" Command="{Binding DismissAlertCommand}"/>
                        <Button DockPanel.Dock="Right" Margin="0,0,10,0" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding AlertSecondaryLabel}" Command="{Binding AlertSecondaryCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{StaticResource Brush.SurfaceActive}" CornerRadius="{StaticResource Radius.Pill}" Padding="14,8">
                                        <TextBlock Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Sm}" FontWeight="SemiBold" Text="{Binding AlertSecondaryLabel}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding AlertTitle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource Type.Sm}" Text="{Binding AlertDetail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AlertDetail}"/>
                        </StackPanel>
                    </DockPanel>
                    </Grid>

                    <!-- ===================== expanded: the panel ===================== -->
                    <Border x:Name="PanelContent" Width="{StaticResource Layout.PanelWidth}" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Padding="{StaticResource Pad.Panel}" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
                    <StackPanel>

                        <!-- tab bar (Home only: the mini player is one compact block with its own way back) -->
                        <DockPanel Margin="0,0,0,12" Visibility="{Binding ShowTabBar, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE713;" FontSize="14" DockPanel.Dock="Right" Margin="10,0,0,0" Focusable="False"
                                    VerticalAlignment="Center" ToolTip="Настройки" AutomationProperties.Name="Настройки" Command="{Binding OpenSettingsCommand}"/>
                            <!-- the weather in the corner opens the forecast; it reads as a tab while that page is open -->
                            <RadioButton DockPanel.Dock="Right" GroupName="Pages" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                                         IsChecked="{Binding IsWeatherPage, Mode=TwoWay}" IsEnabled="{Binding HasForecast}"
                                         Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Прогноз на 24 часа и неделю" AutomationProperties.Name="Прогноз погоды">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Pill}" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource WeatherGlyph}" Data="{Binding WeatherIcon}" Stroke="{Binding WeatherBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding TemperatureText}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceActive}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Tab}" Tag="&#xE80F;" Content="Обзор" GroupName="Pages"
                                             IsChecked="{Binding IsHomePage, Mode=TwoWay}" Focusable="False"/>
                                <RadioButton Style="{StaticResource Tab}" Tag="&#xE8D6;" Content="Музыка" GroupName="Pages" Margin="4,0,0,0"
                                             IsChecked="{Binding IsPlayerPage, Mode=TwoWay}" IsEnabled="{Binding HasMedia}" Focusable="False"
                                             ToolTip="Музыка и слова песни"/>
                                <RadioButton Style="{StaticResource Tab}" Tag="&#xE77F;" Content="Буфер" GroupName="Pages" Margin="4,0,0,0"
                                             IsChecked="{Binding IsClipboardPage, Mode=TwoWay}" Focusable="False"
                                             ToolTip="Что вы копировали, и полка для файлов"/>
                                <RadioButton Style="{StaticResource Tab}" Tag="&#xE70B;" Content="Заметки" GroupName="Pages" Margin="4,0,0,0"
                                             IsChecked="{Binding IsNotesPage, Mode=TwoWay}" Focusable="False"
                                             ToolTip="Заметки и напоминания"/>
                                <RadioButton Style="{StaticResource Tab}" Tag="&#xE770;" Content="Система" GroupName="Pages" Margin="4,0,0,0"
                                             IsChecked="{Binding IsSystemPage, Mode=TwoWay}" Focusable="False"
                                             ToolTip="Wi-Fi, Bluetooth, тема, VPN и питание"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- ============ page: Home ============ -->
                        <StackPanel Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,8,0">
                                    <!-- media card -->
                                    <Border CornerRadius="{StaticResource Radius.Lg}" Padding="{StaticResource Pad.Card}" Background="{Binding CardBackground}"
                                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border Width="{StaticResource Layout.Art}" Height="{StaticResource Layout.Art}" CornerRadius="{StaticResource Radius.Md}"
                                                        Background="{StaticResource Brush.SurfaceActive}" DockPanel.Dock="Left">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="28" Foreground="{StaticResource Brush.TextFaint}"/>
                                                        <Border CornerRadius="{StaticResource Radius.Md}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="16,6,0,0">
                                                    <TextBlock Style="{StaticResource Text.Overline}" Text="ИГРАЕТ"/>
                                                    <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" Margin="0,2,0,0"/>
                                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Artist}"/>
                                                    <Slider x:Name="Progress" Style="{StaticResource TrackProgress}" Margin="0,10,0,0"/>
                                                    <DockPanel>
                                                        <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding RemainingText}" DockPanel.Dock="Right"/>
                                                        <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding PositionText}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE892;" ToolTip="Предыдущий" Focusable="False"
                                                        AutomationProperties.Name="Предыдущий" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/>
                                                <Button Style="{StaticResource IconButton.Control}" Content="{Binding PlayGlyph}" Margin="20,0" Focusable="False"
                                                        ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}"/>
                                                <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE893;" ToolTip="Следующий" Focusable="False"
                                                        AutomationProperties.Name="Следующий" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- empty state -->
                                    <Border Style="{StaticResource Card}" Padding="16,14"
                                            Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="16" Foreground="{StaticResource Brush.TextFaint}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="10,0,0,0"
                                                       Text="Музыка не играет. Запустите трек в любом плеере — он появится здесь."/>
                                        </DockPanel>
                                    </Border>

                                    <!-- volume row -->
                                    <Border Style="{StaticResource Card}" Padding="12,0" Height="44" Margin="0,8,0,0"
                                            Visibility="{Binding HasAudioDevice, Converter={StaticResource BoolToVis}}">
                                        <DockPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton.Ghost}" Content="{Binding VolumeGlyph}" Focusable="False" DockPanel.Dock="Left"
                                                    ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}"/>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Focusable="False" Cursor="Hand"
                                                    Command="{Binding ToggleDeviceListCommand}" ToolTip="Устройство вывода" AutomationProperties.Name="Устройство вывода">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="{StaticResource Brush.SurfaceActive}" CornerRadius="{StaticResource Radius.Md}" Padding="10,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
                                                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Sm}" Text="{Binding DeviceName}"
                                                                           MaxWidth="110" Margin="8,0,6,0"/>
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource Brush.TextMuted}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE9E9;" Focusable="False" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                    ToolTip="Громкость приложений" AutomationProperties.Name="Громкость приложений" Command="{Binding ToggleMixerCommand}"/>
                                            <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding VolumeText}" DockPanel.Dock="Right" Width="24"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Style="{StaticResource Slider.Thin}" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"
                                                    Value="{Binding VolumePercent, Mode=TwoWay}" Focusable="False" AutomationProperties.Name="Громкость"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- device list: inline, not a popup (a popup is its own window and could take focus) -->
                                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0"
                                            Visibility="{Binding IsDeviceListOpen, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Devices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Focusable="False" Cursor="Hand" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}" Padding="10,8">
                                                                        <DockPanel>
                                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" DockPanel.Dock="Right"
                                                                                       Foreground="{StaticResource Brush.Accent}"
                                                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                                            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}"/>
                                                                        </DockPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="10,6,6,4" Visibility="{Binding HasDeviceError, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Focusable="False" Cursor="Hand" Command="{Binding OpenSoundSettingsCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{StaticResource Brush.SurfaceActive}" CornerRadius="{StaticResource Radius.Sm}" Padding="10,4">
                                                                <TextBlock Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Sm}" Text="Настройки звука"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.Danger}" Text="{Binding DeviceError}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- mixer: one row per app on the current device; inline for the same reason as the device list -->
                                    <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0"
                                            Visibility="{Binding IsMixerOpen, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding MixerApps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Height="36" Margin="6,0">
                                                            <Button Style="{StaticResource IconButton.Ghost}" Content="{Binding Glyph}" Focusable="False" DockPanel.Dock="Left"
                                                                    ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}"/>
                                                            <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}" Width="150" DockPanel.Dock="Left"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding Name}"/>
                                                            <TextBlock Style="{StaticResource Text.Numeric}" DockPanel.Dock="Right" Width="28" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding VolumePercent, StringFormat={}{0:0}}"/>
                                                            <Slider Style="{StaticResource Slider.Thin}" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"
                                                                    Value="{Binding VolumePercent, Mode=TwoWay}" Focusable="False" AutomationProperties.Name="{Binding Name}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="12,8" Text="Сейчас ни одно приложение не выводит звук."
                                                       Visibility="{Binding HasNoMixerApps, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- timer: presets when off; countdown, pause and reset when set -->
                                    <Border Style="{StaticResource Card}" Padding="12,0" Height="44" Margin="0,8,0,0">
                                        <Grid VerticalAlignment="Center">
                                            <!-- off: presets -->
                                            <DockPanel x:Name="TimerPresets" Visibility="{Binding IsTimerOff, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="16" Foreground="{StaticResource Brush.TextMuted}" Margin="4,0,10,0" DockPanel.Dock="Left"/>
                                                <TextBlock Style="{StaticResource Text.Muted}" Text="Таймер" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                                                <ItemsControl HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.Items>
                                                        <Button Tag="5" Content="5"/>
                                                        <Button Tag="10" Content="10"/>
                                                        <Button Tag="15" Content="15"/>
                                                        <Button Tag="25" Content="25"/>
                                                        <Button Tag="45" Content="45 мин"/>
                                                    </ItemsControl.Items>
                                                    <ItemsControl.Resources>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Focusable" Value="False"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Margin" Value="4,0,0,0"/>
                                                            <Setter Property="Command" Value="{Binding DataContext.StartTimerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                                            <Setter Property="ToolTip" Value="Запустить таймер"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bg" Background="{StaticResource Brush.SurfaceActive}" CornerRadius="{StaticResource Radius.Pill}" Padding="10,4">
                                                                            <ContentPresenter TextElement.Foreground="{StaticResource Brush.Text}" TextElement.FontSize="{StaticResource Type.Sm}"
                                                                                              TextElement.FontWeight="SemiBold" TextElement.FontFamily="{StaticResource Font.Sans}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ItemsControl.Resources>
                                                </ItemsControl>
                                            </DockPanel>
                                            <!-- set: countdown + pause/resume + reset -->
                                            <DockPanel x:Name="TimerRunning" Visibility="{Binding IsTimerSet, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="16" Foreground="{StaticResource Brush.Accent}" Margin="4,0,10,0" DockPanel.Dock="Left"/>
                                                <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE72C;" DockPanel.Dock="Right" Focusable="False"
                                                        ToolTip="Сбросить" AutomationProperties.Name="Сбросить таймер" Command="{Binding ResetTimerCommand}"/>
                                                <Button Style="{StaticResource IconButton.Ghost}" Content="{Binding TimerPauseGlyph}" DockPanel.Dock="Right" Focusable="False" Margin="0,0,4,0"
                                                        ToolTip="{Binding TimerPauseLabel}" AutomationProperties.Name="{Binding TimerPauseLabel}" Command="{Binding PauseResumeTimerCommand}"/>
                                                <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding TimerText}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- quick actions 2x4 -->
                                <UniformGrid Grid.Column="1" Columns="2" Rows="5" VerticalAlignment="Top">
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xF406;" Margin="0,0,8,8" Focusable="False" Command="{Binding SnipAreaCommand}"
                                            ToolTip="Выделите часть экрана: снимок окажется в буфере и откроется для разметки"><TextBlock Text="Снимок области"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE7F4;" Margin="0,0,0,8" Focusable="False" Command="{Binding CopyScreenCommand}"
                                            ToolTip="Снимок всего экрана в буфер"><TextBlock Text="Снимок экрана"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE8D2;" Margin="0,0,8,8" Focusable="False" Command="{Binding TextFromScreenCommand}"
                                            ToolTip="Выделите область, распознанный текст окажется в буфере"><TextBlock Text="Снять текст"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xED14;" Margin="0,0,0,8" Focusable="False" Command="{Binding QrFromScreenCommand}"
                                            ToolTip="Выделите QR-код, его содержимое окажется в буфере. Ссылки сами не открываются"><TextBlock Text="Считать QR"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xEF3C;" Margin="0,0,8,8" Focusable="False" Command="{Binding PickColorCommand}"
                                            ToolTip="Наведите на любую точку экрана и щёлкните: код цвета окажется в буфере. Esc — отмена"><TextBlock Text="Цвет с экрана"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE75C;" Margin="0,0,0,8" Focusable="False" Command="{Binding PlainTextCommand}"
                                            ToolTip="Текст в буфере станет обычным: без шрифтов, цветов и ссылок"><TextBlock Text="Без формата"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE714;" Margin="0,0,8,8" Focusable="False" Command="{Binding ToggleRecordingCommand}"
                                            ToolTip="Запись этого монитора в «Видео\Stillbar», до 60 кадров/с. Нужен ffmpeg"><TextBlock Text="{Binding RecordTileLabel}"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE721;" Focusable="False" Command="{Binding OpenCommandBarCommand}"
                                            Margin="0,0,0,8" ToolTip="Приложения, файлы, калькулятор, таймер, напоминания. Alt+Пробел из любого окна"><TextBlock Text="Быстрая команда"/></Button>
                                    <Button Style="{StaticResource ActionTile}" Tag="&#xE720;" Margin="0,0,8,0" Focusable="False" Command="{Binding VoiceTypingCommand}"
                                            ToolTip="Голосовой ввод Windows (Win+H): говорите, и текст появится там, где стоит курсор"><TextBlock Text="{Binding VoiceTileLabel}"/></Button>
                                </UniformGrid>
                            </Grid>

                            <!-- app dock: click launches, right-click removes, drop .exe/.lnk to add -->
                            <Border x:Name="DockBar" Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" AllowDrop="True">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding DockApps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Focusable="False" Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding Name}"
                                                        AutomationProperties.Name="{Binding Name}" CommandParameter="{Binding}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Убрать из панели"
                                                                      Command="{Binding PlacementTarget.Tag.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg" Width="{StaticResource Layout.DockIcon}" Height="{StaticResource Layout.DockIcon}"
                                                                    CornerRadius="{StaticResource Radius.Sm}" Background="Transparent">
                                                                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                                    <Setter TargetName="Bg" Property="RenderTransform">
                                                                        <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Focusable="False" Cursor="Hand" Command="{Binding AddAppCommand}"
                                            ToolTip="Добавить программу (или перетащите сюда .exe или ярлык)" AutomationProperties.Name="Добавить программу">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Width="{StaticResource Layout.DockIcon}" Height="{StaticResource Layout.DockIcon}"
                                                        CornerRadius="{StaticResource Radius.Sm}" BorderThickness="1.5" BorderBrush="{StaticResource Brush.Track}" Background="Transparent">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ page: Clipboard (S05): shelf on top, then search and the history ============ -->
                        <StackPanel Visibility="{Binding IsClipboardPage, Converter={StaticResource BoolToVis}}">
                            <!-- shelf: drop files in, drag them out later; code-behind handles the drag -->
                            <Border x:Name="ShelfBar" Style="{StaticResource Card}" Padding="12,8" AllowDrop="True" MinHeight="48">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Text.Overline}" Text="ПОЛКА" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE710;" FontSize="12" DockPanel.Dock="Right" Focusable="False" VerticalAlignment="Center"
                                            ToolTip="Положить файлы на полку (или перетащите их на пилюлю)" AutomationProperties.Name="Положить файлы на полку"
                                            Command="{Binding PickShelfFilesCommand}"/>
                                    <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Text="Перетащите файлы на пилюлю или нажмите +, чтобы забрать их потом."
                                               Visibility="{Binding HasNoShelf, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding ShelfRows}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Focusable="False" Cursor="Hand" Margin="0,2,6,2" ToolTip="Щелчок — открыть, перетаскивание — забрать с полки"
                                                        CommandParameter="{Binding}" Command="{Binding DataContext.OpenShelfItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{StaticResource Brush.SurfaceActive}" CornerRadius="{StaticResource Radius.Sm}" Padding="6,3,2,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Sm}" Text="{Binding Name}" MaxWidth="140"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                                        <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE711;" FontSize="9" Width="20" Height="20" Focusable="False"
                                                                ToolTip="Убрать с полки" AutomationProperties.Name="Убрать с полки" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.RemoveFromShelfCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                                </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,8,0,8">
                                <Button Style="{StaticResource TextButton}" Content="Очистить" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ClearClipsCommand}" ToolTip="Удалить всё, кроме закреплённого"/>
                                <TextBox Style="{StaticResource Field}" Tag="Поиск по буферу" Text="{Binding ClipQuery, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Поиск по буферу"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource Text.Muted}" Margin="4,12" Text="{Binding ClipEmptyText}"
                                       Visibility="{Binding HasNoClips, Converter={StaticResource BoolToVis}}"/>
                            <ScrollViewer MaxHeight="292" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding ClipRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Focusable="False" Cursor="Hand" Margin="0,0,0,4" CommandParameter="{Binding}" ToolTip="Вставить в окно, где вы печатаете"
                                                    Command="{Binding DataContext.PasteClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Md}" Padding="12,8,6,8">
                                                            <DockPanel>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource IconButton.Ghost}" Content="{Binding PinGlyph}" FontSize="13" Focusable="False"
                                                                            ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                    <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE711;" FontSize="11" Focusable="False"
                                                                            ToolTip="Удалить" AutomationProperties.Name="Удалить" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </StackPanel>
                                                                <Border DockPanel.Dock="Left" Margin="0,0,12,0" CornerRadius="{StaticResource Radius.Sm}" ClipToBounds="True"
                                                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                                    <Image Source="{Binding Image}" Height="36" MaxWidth="64" Stretch="Uniform"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE840;" FontSize="10" Foreground="{StaticResource Brush.Accent}" Margin="0,0,6,0"
                                                                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Xs}" Text="{Binding Meta}"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- ============ page: Notes: list on the left, editor on the right, reminders below ============ -->
                        <StackPanel Visibility="{Binding IsNotesPage, Converter={StaticResource BoolToVis}}">
                            <Grid Height="232">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="0,0,8,0">
                                    <Button Style="{StaticResource TextButton}" Content="Новая заметка" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Command="{Binding NewNoteCommand}"/>
                                    <TextBlock Style="{StaticResource Text.Muted}" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,4,4,0"
                                               Text="Здесь будут заметки. Начните печатать справа."
                                               Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVis}}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsControl ItemsSource="{Binding NoteRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Focusable="False" Cursor="Hand" Margin="0,0,0,4" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Md}" Padding="10,6,4,6"
                                                                        BorderThickness="1" BorderBrush="Transparent">
                                                                    <DockPanel>
                                                                        <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE74D;" FontSize="11" DockPanel.Dock="Right" Focusable="False"
                                                                                ToolTip="Удалить заметку" AutomationProperties.Name="Удалить заметку" CommandParameter="{Binding}"
                                                                                Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                        <StackPanel>
                                                                            <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Xs}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                                <!-- the editor: plain text; the first line is the title; «[ ]» and «[x]» make a checklist -->
                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="4">
                                    <Grid>
                                        <TextBlock Margin="10,8" TextWrapping="Wrap" IsHitTestVisible="False"
                                                   Text="Первая строка — название. «[ ]» в начале строки — пункт списка, «[x]» — выполнен.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoteText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="6,6"
                                                 Foreground="{StaticResource Brush.Text}" CaretBrush="{StaticResource Brush.Text}" SelectionBrush="{StaticResource Brush.Accent}"
                                                 FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Base}" AutomationProperties.Name="Текст заметки"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- reminders: type a phrase, Enter -->
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBox Style="{StaticResource Field}" Tag="Напомнить: «через 10 минут чай», «завтра в 9 врач», «по будням в 10 стендап»"
                                             Text="{Binding ReminderInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Новое напоминание">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddReminderFromInputCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <ItemsControl ItemsSource="{Binding ReminderRows}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasReminders, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Height="30" Margin="6,0,0,0">
                                                    <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE711;" FontSize="10" DockPanel.Dock="Right" Focusable="False"
                                                            ToolTip="Удалить напоминание" AutomationProperties.Name="Удалить напоминание" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.RemoveReminderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="12" Foreground="{StaticResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Sm}" Text="{Binding When}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                    <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ page: weather: now, 24 hours, 7 days, and the rain note ============ -->
                        <StackPanel Visibility="{Binding IsWeatherPage, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Card}" Padding="14,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding TodayRange}" HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Sm}" Text="{Binding WeatherPlace}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource WeatherGlyph}" Data="{Binding WeatherIcon}" Stroke="{Binding WeatherBrush}" DockPanel.Dock="Left" Margin="0,0,14,0">
                                        <Path.LayoutTransform><ScaleTransform ScaleX="1.75" ScaleY="1.75"/></Path.LayoutTransform>
                                    </Path>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.Title}" FontSize="22" Text="{Binding TemperatureText}"/>
                                        <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding WeatherSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- rain in the next hour or so -->
                            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0"
                                    Visibility="{Binding HasRainNote, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Foreground="{StaticResource Brush.Accent}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock Style="{StaticResource Text.Base}" Text="{Binding RainNote}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <!-- 24 hours in two rows of 12 -->
                            <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding HourRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1,0,3" MinHeight="72">
                                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Xs}" Text="{Binding Label}" HorizontalAlignment="Center"/>
                                                <Path Style="{StaticResource WeatherGlyph}" Data="{Binding Icon}" Stroke="{Binding IconBrush}" HorizontalAlignment="Center" Margin="0,3"/>
                                                <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="{Binding Temperature}" HorizontalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Xs}" Foreground="{StaticResource Brush.Accent}" Text="{Binding Rain}"
                                                           HorizontalAlignment="Center" Visibility="{Binding HasRain, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- 7 days: name · glyph · rain · min ━━ max, bars on one scale for the week -->
                            <Border Style="{StaticResource Card}" Padding="14,4" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding DayRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Height="26">
                                                <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}" Width="96" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <Path Style="{StaticResource WeatherGlyph}" Data="{Binding Icon}" Stroke="{Binding IconBrush}" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                                                <TextBlock Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Sm}" Foreground="{StaticResource Brush.Accent}" Text="{Binding Rain}"
                                                           Width="48" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="{Binding Max}" Width="40" DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <Grid Width="150" Height="5" DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource Brush.Track}" CornerRadius="2.5"/>
                                                    <Border Background="{StaticResource Brush.Accent}" CornerRadius="2.5" HorizontalAlignment="Left"
                                                            Margin="{Binding BarOffset}" Width="{Binding BarWidth}"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Min}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- ============ page: Система: switches, VPN, power ============ -->                        <StackPanel Visibility="{Binding IsSystemPage, Converter={StaticResource BoolToVis}}">
                            <UniformGrid Columns="4">
                                <ToggleButton Style="{StaticResource ToggleTile}" Tag="&#xE701;" Margin="0,0,8,0" IsChecked="{Binding WifiOn, Mode=TwoWay}"
                                              IsEnabled="{Binding HasWifi}" ToolTip="Включить или выключить Wi-Fi" AutomationProperties.Name="Wi-Fi">
                                    <TextBlock Text="Wi-Fi"/>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToggleTile}" Tag="&#xE702;" Margin="0,0,8,0" IsChecked="{Binding BluetoothOn, Mode=TwoWay}"
                                              IsEnabled="{Binding HasBluetooth}" ToolTip="Включить или выключить Bluetooth" AutomationProperties.Name="Bluetooth">
                                    <TextBlock Text="Bluetooth"/>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource ToggleTile}" Tag="&#xE771;" Margin="0,0,8,0" IsChecked="{Binding DarkTheme, Mode=TwoWay}"
                                              ToolTip="Тёмная тема Windows и приложений" AutomationProperties.Name="Тёмная тема">
                                    <TextBlock Text="Тёмная тема"/>
                                </ToggleButton>
                                <Button Style="{StaticResource ActionTile}" Tag="&#xE713;" Width="Auto" Focusable="False" Command="{Binding OpenWindowsSettingsCommand}"
                                        CommandParameter="ms-settings:" ToolTip="Открыть «Параметры» Windows"><TextBlock Text="Параметры"/></Button>
                            </UniformGrid>

                            <!-- paired Bluetooth devices: state from Windows; connecting is done on Windows' Bluetooth page (no public API for it) -->
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0"
                                    Visibility="{Binding HasBluetooth, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Height="28">
                                        <Button Style="{StaticResource TextButton}" Content="Подключить…" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                ToolTip="Подключение и отключение — на странице Bluetooth в параметрах Windows"
                                                Command="{Binding OpenWindowsSettingsCommand}" CommandParameter="ms-settings:bluetooth"/>
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="УСТРОЙСТВА BLUETOOTH" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,4" Text="Сопряжённых устройств нет."
                                               Visibility="{Binding HasNoPaired, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding BluetoothRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Height="34" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" DockPanel.Dock="Left" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextMuted}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Xs}" Text="{Binding State}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- VPN: Windows' own connections; the credentials are the ones Windows saved -->
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <DockPanel Height="28">
                                        <Button Style="{StaticResource TextButton}" Content="Добавить" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Command="{Binding OpenWindowsSettingsCommand}" CommandParameter="ms-settings:network-vpn"/>
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="VPN" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,4" Text="VPN-подключений в Windows нет."
                                               Visibility="{Binding HasNoVpn, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding VpnRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Height="34">
                                                    <Button Style="{StaticResource TextButton}" Content="{Binding Action}" DockPanel.Dock="Right" VerticalAlignment="Center" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.ToggleVpnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE705;" FontSize="14" DockPanel.Dock="Left" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextMuted}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Name}"/>
                                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Xs}" Text="{Binding State}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- power: restart and shut down ask once more before acting -->
                            <UniformGrid Columns="4" Margin="0,8,0,0">
                                <Button Style="{StaticResource ActionTile}" Tag="&#xE72E;" Width="Auto" Margin="0,0,8,0" Focusable="False" Command="{Binding LockComputerCommand}"
                                        ToolTip="Заблокировать компьютер (Win+L)"><TextBlock Text="Заблокировать"/></Button>
                                <Button Style="{StaticResource ActionTile}" Tag="&#xE708;" Width="Auto" Margin="0,0,8,0" Focusable="False" Command="{Binding SleepComputerCommand}"
                                        ToolTip="Спящий режим"><TextBlock Text="Сон"/></Button>
                                <Button Style="{StaticResource ActionTile}" Tag="&#xE777;" Width="Auto" Margin="0,0,8,0" Focusable="False" Command="{Binding RestartComputerCommand}"
                                        ToolTip="Нажмите дважды. Несохранённое в программах может пропасть"><TextBlock Text="{Binding RestartLabel}"/></Button>
                                <Button Style="{StaticResource ActionTile}" Tag="&#xE7E8;" Width="Auto" Focusable="False" Command="{Binding ShutDownComputerCommand}"
                                        ToolTip="Нажмите дважды. Несохранённое в программах может пропасть"><TextBlock Text="{Binding ShutdownLabel}"/></Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- ============ page: compact mini player (S04): one block, lyrics on the right ============ -->
                        <Border Visibility="{Binding IsPlayerPage, Converter={StaticResource BoolToVis}}"
                                CornerRadius="{StaticResource Radius.Lg}" Padding="14,12" Background="{Binding CardBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <!-- header: cover · title/artist/album · clock, weather and the way back home -->
                                    <DockPanel>
                                        <Border Width="{StaticResource Layout.MiniArt}" Height="{StaticResource Layout.MiniArt}" CornerRadius="{StaticResource Radius.Md}"
                                                Background="{StaticResource Brush.SurfaceActive}" DockPanel.Dock="Left">
                                            <Border CornerRadius="{StaticResource Radius.Md}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE80F;" HorizontalAlignment="Right" Focusable="False"
                                                    ToolTip="Обзор" AutomationProperties.Name="Обзор" Command="{Binding ShowHomeCommand}"/>
                                            <TextBlock Style="{StaticResource Text.Pill}" Text="{Binding Clock}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}">
                                                <Path Style="{StaticResource WeatherGlyph}" Data="{Binding WeatherIcon}" Stroke="{Binding WeatherBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource Type.Sm}" Text="{Binding TemperatureText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="14,4,0,0" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}"/>
                                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Artist}"/>
                                            <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource Type.Sm}" Text="{Binding Album}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- progress in one row: 0:48 ━━━━━ −3:00 -->
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding PositionText}" DockPanel.Dock="Left" Width="40" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Text.Numeric}" Text="{Binding RemainingText}" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="PlayerProgress" Style="{StaticResource TrackProgress}" Margin="6,0" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- controls: lyrics toggle on the left, transport in the middle -->
                                    <Grid Margin="0,6,0,0">
                                        <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE8D2;" HorizontalAlignment="Left" Focusable="False"
                                                ToolTip="Показать или скрыть слова" AutomationProperties.Name="Слова песни" Command="{Binding ToggleLyricsCommand}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE892;" ToolTip="Предыдущий" Focusable="False"
                                                    AutomationProperties.Name="Предыдущий" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/>
                                            <Button Style="{StaticResource IconButton.Control}" Content="{Binding PlayGlyph}" Margin="20,0" Focusable="False"
                                                    ToolTip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}"/>
                                            <Button Style="{StaticResource IconButton.Ghost}" Content="&#xE893;" ToolTip="Следующий" Focusable="False"
                                                    AutomationProperties.Name="Следующий" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- lyrics, same block: previous · current (big) · next; or why there are none; LRCLIB credited -->
                                <DockPanel Grid.Column="1" Width="{StaticResource Layout.LyricsWidth}" Margin="20,0,0,0"
                                           Visibility="{Binding ShowLyricsColumn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Numeric}" FontSize="{StaticResource Type.Overline}" Text="слова: LRCLIB" HorizontalAlignment="Right"/>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Text="{Binding LyricsStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.TextFaint}" Text="{Binding PreviousLine}"/>
                                        <TextBlock x:Name="CurrentLyric" Style="{StaticResource Text.Title}" Text="{Binding CurrentLine}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" Margin="0,4">
                                            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.TextFaint}" Text="{Binding NextLine}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
